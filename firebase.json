{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    { "source": "functions", "codebase": "default", "ignore": ["node_modules", ".git"] }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "**/.*", "**/node_modules/**", "functions/**",
      "design-system/**", "README.md", "firestore.rules", "firestore.indexes.json"
    ],
    "headers": [
      { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ] }
    ]
  }
}
